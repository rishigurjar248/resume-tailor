# ResumeLM Free Forever
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Configure at least one permitted free AI provider. The app never exposes these keys to the browser.
# Recommended fallback order: OpenRouter -> Google Gemini -> Groq
OPENROUTER_API_KEY=your_openrouter_api_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here 

# Supabase (Docker local defaults)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional local Redis for provider circuit state
USE_LOCAL_REDIS=true
REDIS_URL=redis://localhost:6379

# Optional product analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_LLM_ANALYTICS_DISABLED=true
